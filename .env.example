# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Multi-Provider AI Router (supports: openai | anthropic | gemini)
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_FALLBACK_PROVIDER=
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Admin Access (also verified against Supabase `admins` table)
ADMIN_EMAIL=

# Paystack (premium subscriptions)
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key

# PostHog (analytics)
NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web Push (VAPID) - run `node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"`
# and paste the values below
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:support@example.com

# Push cron secret (protects /api/push/send on Vercel)
CRON_SECRET=generate-a-random-secret
